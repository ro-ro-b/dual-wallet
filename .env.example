API_URL=https://api.dual.network
# Seals the session cookie. REQUIRED in every environment - there is no
# fallback key; without a valid one, sign-in and every session route answer
# 503 session_unavailable. Generate with:
#   openssl rand -base64 32
# Keep it stable across deploys; changing it signs every wallet out. For a
# throwaway local run an ephemeral key is fine.
SESSION_SECRET=
VIEWER_BASE_DOMAIN=wallet.dual.network
# Organization used when a request carries no /<organization-id> entry link.
DEFAULT_ORGANIZATION_ID=
NEXT_PUBLIC_APP_URL=http://demo.localhost:3000
NEXT_PUBLIC_EXTERNAL_FACE_BRIDGE_ORIGINS=https://faces.dual.network
NEXT_PUBLIC_EXTERNAL_FACE_BRIDGE_APPLICATIONS=dual.dpp@1=https://faces.dual.network/dpp/v1/
# Server-only product-application registry (JSON array, see
# docs/external-face-integration.md). Also read at build time for the exact
# CSP frame-src origins, so a new origin needs a rebuild. Invalid entries are
# dropped. Empty means no product programmes.
PRODUCT_FACE_APPLICATIONS=[]
# Server-only Ed25519 signer for one-time product-face assertions: PKCS8 PEM
# (or base64 of it) and its key ID. Unset or invalid, every assertion request
# fails closed with 503 face_assertion_unprovisioned. Never commit a real key.
FACE_ASSERTION_SIGNING_KEY=
FACE_ASSERTION_KEY_ID=
# Server-only, default off: comma-separated exact https origins of bound
# runtimes behind Vercel Deployment Protection (Trusted Sources). Only runtime
# calls to these origins carry this deployment's platform OIDC token
# (x-vercel-trusted-oidc-idp-token); a listed origin without a token, or an
# invalid list, is refused before anything is sent. Holds no secret.
# TIG_RUNTIME_OIDC_ORIGINS=
# Branded wallet host (docs/branded-wallet-hosts.md): the canonical JSON
# host configuration and its sha256 pin. Leave both unset for the generic
# wallet; with either set, the deployment must be a fully valid branded host
# or it answers 503. A build input (static pages render the identity).
# WALLET_HOST_CONFIGURATION=
# WALLET_HOST_CONFIGURATION_SHA256=
